{
  "permissions": {
    "allow": [
      "Bash(cargo fmt:*)",
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo test:*)",
      "Bash(cargo run:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo remove:*)",
      "Bash(rustfmt:*)",
      "Bash(scripts/screenshot.sh:*)",
      "Bash(bash scripts/screenshot.sh:*)",
      "Bash(scripts/reset-dev-data.sh:*)",
      "Bash(bash scripts/reset-dev-data.sh:*)",
      "Bash(npm:*)"
    ],
    "ask": [
      "Bash(cargo install:*)",
      "Bash(cargo add:*)"
    ]
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-create.sh\""
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-remove.sh\""
          }
        ]
      }
    ]
  }
}
